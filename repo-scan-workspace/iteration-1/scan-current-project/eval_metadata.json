      "description": "Report mentions no tests, missing tests, or absence of test directory"
    },
    {
      "text": "Output flags missing CI config",
      "type": "semantic",
      "description": "Report mentions no CI, missing CI, no GitHub Actions, or similar"
    }
  ]
