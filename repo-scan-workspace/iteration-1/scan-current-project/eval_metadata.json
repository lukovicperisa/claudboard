{
  "eval_id": 0,
  "eval_name": "scan-current-project",
  "prompt": "/repo-scan /Users/LUP1BG/Documents/BoschProjects/claude-repo-scan",
  "assertions": [
    {
      "text": "Output contains '## Repo scan' header with the target path",
